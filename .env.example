# ============================================================================
#  kite-alerts configuration
#  Copy this file to `.env` and fill in the values.  NEVER commit `.env`.
#      cp .env.example .env && chmod 600 .env
#  Values that may contain a `#` character must be quoted: KEY="abc#def"
#  Every key the settings model reads is listed here; `kite-alerts config-check`
#  warns about anything unrecognised in your `.env`.
# ============================================================================

# ---------- Kite Connect credentials (required for live) --------------------
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Access token expires daily (~06:00 IST). Refresh with: kite-alerts login
KITE_ACCESS_TOKEN=

# ---------- Instruments to watch (comma separated, EXCHANGE:TRADINGSYMBOL) ---
# Equity:               NSE:RELIANCE
# Explicit future:      NFO:NIFTY26NOVFUT
# Nearest-expiry alias: NFO:NIFTY-FUT        (resolved from the instrument dump)
SYMBOLS=NSE:RELIANCE,NSE:INFY,NFO:NIFTY-FUT

# ---------- Alert channels: console, telegram, slack, smtp ------------------
NOTIFY_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# ---------- Notifier delivery -------------------------------------------------
NOTIFY_RETRIES=4
NOTIFY_TIMEOUT_SECONDS=10
# Per-channel token bucket; raise only if your provider allows it.
NOTIFY_MAX_PER_MINUTE=20
# Drop a repeat of the same dedup key (e.g. the same alert) within this window.
NOTIFY_DEDUP_SECONDS=300
# Bounded notifier queue; overflow drops the oldest (system first, then alerts)
# and is counted as notifier_dropped_total.
NOTIFY_QUEUE_MAX=5000

# ---------- Session (IST) ----------------------------------------------------
SESSION_OPEN=09:15
SESSION_CLOSE=15:30
# Optional YAML file with NSE holidays (config/holidays.yaml ships empty and
# warns at startup until you fill it from the official NSE list).
# Refresh it with: python scripts/refresh_holidays.py --year 2026
HOLIDAY_FILE=config/holidays.yaml
# Optional dated session overrides (muhurat trading, special Saturdays).
SPECIAL_SESSIONS_FILE=config/sessions.yaml
SESSION_PRE_OPEN=09:00
SESSION_CLOSING_END=16:00

# ---------- Strategy parameters ---------------------------------------------
EMA_FAST=9
EMA_SLOW=21
EMA_CROSS_LOOKBACK=5
RSI_PERIOD=14
RSI_BUY_MIN=55
RSI_BUY_MAX=75
RSI_SELL_MAX=45
RSI_SELL_MIN=25
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ORB_MINUTES=15
ORB_BUFFER_PCT=0.0
OI_ENABLED=true
OI_LOOKBACK=5
OI_MIN_CHANGE_PCT=0.5
MIN_AGREE=4
COOLDOWN_MINUTES=15
MIN_SIDE_FLIP_MINUTES=0
WARMUP_BARS=40
MAX_BARS=500
# "first" reproduces the prototype's indicator values exactly.
# "sma" matches Wilder/TA-Lib seeding (differs slightly for the first ~60 bars).
INDICATOR_SEED=first
# Refuse to alert when fewer rules than MIN_AGREE are evaluable (0 = legacy).
# Must be <= MIN_AGREE.
MIN_AVAILABLE_RULES=0

# ---------- Per-rule switches, weights and mandates -------------------------
# weight scales a rule's vote (1.0 = one vote, as in the prototype).
# required=true means the rule MUST vote with the alert side, or no alert fires.
RULE_EMA_CROSS_ENABLED=true
RULE_EMA_CROSS_WEIGHT=1.0
RULE_EMA_CROSS_REQUIRED=false
RULE_RSI_ZONE_ENABLED=true
RULE_RSI_ZONE_WEIGHT=1.0
RULE_RSI_ZONE_REQUIRED=false
RULE_MACD_ENABLED=true
RULE_MACD_WEIGHT=1.0
RULE_MACD_REQUIRED=false
RULE_ORB_ENABLED=true
RULE_ORB_WEIGHT=1.0
RULE_ORB_REQUIRED=false
RULE_OI_ENABLED=true
RULE_OI_WEIGHT=1.0
RULE_OI_REQUIRED=false

# Optional per-symbol overrides (YAML); leave empty to use one configuration.
OVERRIDES_FILE=

# ---------- Runtime ----------------------------------------------------------
DB_PATH=data/kite_alerts.db
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=logs
CACHE_DIR=cache
WARMUP_DAYS=4
# Hourly "I am alive" message to the notifier (0 disables).
HEARTBEAT_MINUTES=60

# ---------- Resilience -------------------------------------------------------
# Kite's historical endpoint allows ~3 requests/second.
HISTORY_RATE_LIMIT_PER_SEC=3
HISTORY_MAX_RETRIES=5
RETRY_BASE_SECONDS=1
RETRY_CAP_SECONDS=30
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=120
# Feed-level silence before a notice; a reconnect needs two full windows.
FEED_STALE_SECONDS=120
# Per-instrument silence before that symbol is reported.
SYMBOL_STALE_SECONDS=600
RECONNECT_MAX_TRIES=25
RECONNECT_MIN_DELAY=1
RECONNECT_MAX_DELAY=60
REQUEST_TIMEOUT_SECONDS=10
# Websocket -> worker queue; ticks are dropped (and counted) when it is full.
TICK_QUEUE_SIZE=20000

# ---------- Observability (bind loopback by default; never expose publicly) --
HTTP_ENABLED=true
HTTP_HOST=127.0.0.1
HTTP_PORT=9109
# Binding a non-loopback host refuses to start unless this is explicitly true.
HTTP_ALLOW_PUBLIC=false
