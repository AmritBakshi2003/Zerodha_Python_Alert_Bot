# ============================================================================
#  kite-alerts configuration
#  Copy this file to `.env` and fill in the values.  NEVER commit `.env`.
#      cp .env.example .env && chmod 600 .env
#  Values that may contain a `#` character must be quoted: KEY="abc#def"
# ============================================================================

# ---------- Kite Connect credentials (required for live) --------------------
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Access token expires daily (~06:00 IST). Refresh with: kite-alerts login
KITE_ACCESS_TOKEN=

# ---------- Instruments to watch (comma separated, EXCHANGE:TRADINGSYMBOL) ---
# Equity:               NSE:RELIANCE
# Explicit future:      NFO:NIFTY26NOVFUT
# Nearest-expiry alias: NFO:NIFTY-FUT        (resolved from the instrument dump)
SYMBOLS=NSE:RELIANCE,NSE:INFY,NFO:NIFTY-FUT

# ---------- Alert channels: console, telegram, slack, smtp ------------------
NOTIFY_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# ---------- Session (IST) ----------------------------------------------------
SESSION_OPEN=09:15
SESSION_CLOSE=15:30
# Optional YAML file with NSE holidays. An empty list is safe: the staleness
# watchdog still detects a closed market.
HOLIDAY_FILE=config/holidays.yaml

# ---------- Strategy parameters ---------------------------------------------
EMA_FAST=9
EMA_SLOW=21
EMA_CROSS_LOOKBACK=5
RSI_PERIOD=14
RSI_BUY_MIN=55
RSI_BUY_MAX=75
RSI_SELL_MAX=45
RSI_SELL_MIN=25
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ORB_MINUTES=15
ORB_BUFFER_PCT=0.0
OI_ENABLED=true
OI_LOOKBACK=5
OI_MIN_CHANGE_PCT=0.5
MIN_AGREE=4
COOLDOWN_MINUTES=15
MIN_SIDE_FLIP_MINUTES=0
WARMUP_BARS=40
MAX_BARS=500
# "first" reproduces the prototype's indicator values exactly.
# "sma" matches Wilder/TA-Lib seeding (differs slightly for the first ~60 bars).
INDICATOR_SEED=first

# Optional per-symbol overrides (YAML). See config/overrides.example.yaml
OVERRIDES_FILE=
# Refuse to alert when fewer rules than MIN_AGREE are evaluable (0 = legacy).
MIN_AVAILABLE_RULES=0

# ---------- Runtime ----------------------------------------------------------
DB_PATH=data/kite_alerts.db
LOG_LEVEL=INFO
LOG_JSON=false
LOG_DIR=logs
CACHE_DIR=cache
WARMUP_DAYS=4
# Hourly "I am alive" message to the notifier (0 disables).
HEARTBEAT_MINUTES=60

# ---------- Resilience -------------------------------------------------------
HISTORY_RATE_LIMIT_PER_SEC=3
HISTORY_MAX_RETRIES=5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=120
FEED_STALE_SECONDS=120
SYMBOL_STALE_SECONDS=600
RECONNECT_MAX_TRIES=25

# ---------- Observability (bind loopback by default; never expose publicly) --
HTTP_ENABLED=true
HTTP_HOST=127.0.0.1
HTTP_PORT=9109
