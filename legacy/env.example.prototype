# ---------- Kite Connect credentials ----------
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
# Access token expires daily. Run `python login.py` each morning to refresh it.
KITE_ACCESS_TOKEN=

# ---------- What to watch (comma separated, EXCHANGE:TRADINGSYMBOL) ----------
# Equity: NSE:RELIANCE   |   Futures (has OI): NFO:NIFTY26NOVFUT
SYMBOLS=NSE:RELIANCE,NSE:INFY,NFO:NIFTY26NOVFUT

# ---------- Alert channels: console, telegram, slack (comma separated) ----------
NOTIFY_CHANNELS=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# ---------- Strategy parameters (all optional; defaults shown) ----------
EMA_FAST=9
EMA_SLOW=21
EMA_CROSS_LOOKBACK=5      # a cross within the last N candles counts
RSI_PERIOD=14
RSI_BUY_MIN=55            # BUY needs RSI in [BUY_MIN, BUY_MAX]
RSI_BUY_MAX=75
RSI_SELL_MAX=45           # SELL needs RSI in [SELL_MIN, SELL_MAX]
RSI_SELL_MIN=25
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
ORB_MINUTES=15            # opening range = first N minutes from 09:15
ORB_BUFFER_PCT=0.0        # extra % beyond range high/low required
OI_ENABLED=true           # auto-ignored for symbols with no OI (equities)
OI_LOOKBACK=5             # candles
OI_MIN_CHANGE_PCT=0.5
MIN_AGREE=4               # how many rules must agree (capped to rules available)
COOLDOWN_MINUTES=15       # min gap between same-side alerts per symbol
WARMUP_BARS=40
MAX_BARS=500
