# --- secrets: never commit these ---------------------------------------------
.env
.env.*
!.env.example
*.pem
secrets/
secrets/*

# --- runtime state -----------------------------------------------------------
# Anchored on purpose: an unanchored `data/` also matches src/kite_alerts/data/,
# which is a source package and must never be ignored by git again.
/logs/
/cache/
/data/
*.db
*.db-wal
*.db-shm
*.sqlite3
dead-letter.jsonl

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python-version

# --- tooling -----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.DS_Store

# --- JS / e2e_ui ---------------------------------------------------------------
node_modules/
playwright-report/
test-results/
*.trace.zip
